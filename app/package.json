{
  "name": "amrit-electron",
  "version": "2.0.0",
  "description": "AMRIT local-first antimicrobial resistance desktop application",
  "main": "./out/main/index.js",
  "type": "module",
  "author": "Indian Council of Medical Research",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "check": "tsc --noEmit -p tsconfig.json && eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:generate": "python3 ../tools/generate_catalog_seed.py",
    "catalog:verify": "python3 ../tools/generate_catalog_seed.py --check",
    "demo:network": "jiti scripts/seed-demo-network.ts",
    "outbreak:corpus": "jiti scripts/generate-outbreak-corpus.ts",
    "build": "electron-vite build",
    "dist": "pnpm run check && pnpm test && pnpm run build && electron-builder",
    "dist:dir": "pnpm run build && electron-builder --dir",
    "benchmark": "jiti scripts/run-benchmark.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "5.2.2",
    "i18next": "26.3.6",
    "lucide-react": "1.31.0",
    "open-location-code": "1.0.3",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.62.0",
    "react-i18next": "17.0.11",
    "recharts": "3.10.1",
    "ws": "8.21.3",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/papaparse": "5.3.16",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.35.0",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jiti": "^2.7.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.42.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "org.amrit.desktop",
    "productName": "AMRIT",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "mac": {
      "category": "public.app-category.medical",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSLocationWhenInUseUsageDescription": "AMRIT uses this computer's location only to record where this laboratory is, and only after you consent in Sync settings. Patient or specimen locations are never collected."
      }
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "category": "Science",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  }
}
