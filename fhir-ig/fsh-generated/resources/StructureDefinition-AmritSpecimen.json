  "fhirVersion": "4.0.1",
  "kind": "resource",
  "abstract": false,
  "type": "Specimen",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Specimen",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Specimen.type",
        "path": "Specimen.type",
        "min": 1
      },
      {
        "id": "Specimen.type.coding",
        "path": "Specimen.type.coding",
        "short": "WHONET specimen code; SNOMED concept where the catalogue carries one"
      },
      {
        "id": "Specimen.subject",
        "path": "Specimen.subject",
        "min": 1
      },
      {
        "id": "Specimen.collection.collected[x]",
