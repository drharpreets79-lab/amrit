DJANGO_SECRET_KEY=replace-with-32-random-bytes
DJANGO_DEBUG=0
# Comma-separated public DNS names/IPs for this server. Never use * on a reachable deployment.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=amrit_central
POSTGRES_USER=amrit
POSTGRES_PASSWORD=amrit
# POSTGRES_PORT only used when docker-compose.override.yml exposes db on host.
POSTGRES_PORT=55432
WEB_PORT=8000
# Creating the first administrator here requires DJANGO_SUPERUSER_PASSWORD to be set to at
# least 12 characters; the entrypoint refuses to invent one. Prefer 'manage.py bootstrap'.
DJANGO_CREATE_SUPERUSER=0
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
# No default. The entrypoint refuses to create an account without one of at least 12
# characters, because a published default on a reachable deployment is an open door.
DJANGO_SUPERUSER_PASSWORD=
AMRIT_QUERY_TTL_SECONDS=3600
AMRIT_LONGPOLL_MAX_WAIT=90
AMRIT_LONGPOLL_TICK=1.0
AMRIT_REFRESH_WAIT_SECONDS=30
AMRIT_ONLINE_WINDOW_SECONDS=300
AMRIT_K_ANONYMITY_FLOOR=5
# Channels (WebSocket bridge) backend. Compose sets this to the redis service.
REDIS_URL=redis://redis:6379/0
# Seed demo sites/users + threshold rules + dashboard KPI snapshots on first boot.
AMRIT_SEED_DEMO=0
# Dashboards flag snapshots older than this as stale.
AMRIT_SNAPSHOT_TTL_SECONDS=21600
# Scheduler container refresh cadence (seconds).
AMRIT_REFRESH_INTERVAL_SECONDS=1800

# --- Site enrolment -----------------------------------------------------------
# Required to register a site or issue a site bearer token. Both endpoints were
# previously reachable with no credential; issuing a token also rotates it, so an
# unauthenticated caller knowing a lab code could impersonate a laboratory and cut off its
# sync in the same request. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AMRIT_ENROLMENT_SECRET=

# Set to 1 only as a temporary transition for a deployment that cannot set the secret yet.
# While it is on, anyone who can reach this server can register sites and issue site
# tokens. Each request is logged as a warning.
AMRIT_ALLOW_UNAUTHENTICATED_ENROLMENT=0

# --- Country profile ----------------------------------------------------------
# A curated profile id ("IN") or any ISO 3166-1 code, which is synthesized. Empty means
# the unconfigured fallback.
#
# AMRIT_SEED_DEMO=1 seeds the demonstration pack for whichever country this names. Packs
# exist for India (IN) and Testland (TESTLAND); any other country is reported and skipped,
# so leaving this empty gives a portal that starts with an empty registry rather than one
# filled with another country's hospitals.
AMRIT_COUNTRY_PROFILE=
